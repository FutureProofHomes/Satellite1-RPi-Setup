#!/bin/sh
set -e

PACKAGE_NAME="@PACKAGE_NAME@"

echo "${PACKAGE_NAME}: postinst starting..."

SHARE_OVL="/usr/share/${PACKAGE_NAME}/overlays"

# Detect boot dir
if [ -d /boot/firmware ]; then
    BOOTDIR="/boot/firmware"
else
    BOOTDIR="/boot"
fi

CFG="${BOOTDIR}/config.txt"
CMDLINE="${BOOTDIR}/cmdline.txt"
BOOT_OVL="${BOOTDIR}/overlays"

echo "${PACKAGE_NAME}: Using BOOTDIR=${BOOTDIR}, CFG=${CFG}"

# ----- Helpers -----

# Ensure a dtparam key=value exists; if present (even commented), replace with dtparam=key=value
ensure_dtparam() {
    key="$1"; val="$2"
    if grep -Eq "^[#[:space:]]*dtparam[[:space:]]*=[[:space:]]*${key}=" "$CFG"; then
        sed -i -E "s|^[#[:space:]]*dtparam[[:space:]]*=[[:space:]]*${key}=.*$|dtparam=${key}=${val}|" "$CFG"
    else
        printf "dtparam=%s=%s\n" "$key" "$val" >> "$CFG"
    fi
}

# Only add dtparam if key is not present in any form
ensure_dtparam_if_missing() {
    key="$1"; val="$2"
    if ! grep -Eq "^[#[:space:]]*dtparam[[:space:]]*=[[:space:]]*${key}=" "$CFG"; then
        printf "dtparam=%s=%s\n" "$key" "$val" >> "$CFG"
    fi
}

# Ensure a dtoverlay line for a specific overlay *name* (with or without params) exists
# Matches: dtoverlay=name or dtoverlay=name,<params>
ensure_overlay_name() {
    name="$1"
    if ! grep -Eq "^[#[:space:]]*dtoverlay[[:space:]]*=[[:space:]]*${name}(\\b|,)" "$CFG"; then
        printf "dtoverlay=%s\n" "$name" >> "$CFG"
    fi
}

# Ensure an exact dtoverlay line with parameters exists.
ensure_overlay_line() {
    line="$1"
    if ! grep -Eq "^[#[:space:]]*dtoverlay[[:space:]]*=[[:space:]]*${line}[[:space:]]*$" "$CFG"; then
        printf "dtoverlay=%s\n" "$line" >> "$CFG"
    fi
}

# The i2c-sensor overlay selects the AHT20 with a boolean ``aht20`` parameter.
# Earlier setup packages wrote an unsupported ``chip=aht20`` parameter instead.
ensure_aht20_overlay() {
    sed -i -E 's|^[[:space:]]*dtoverlay[[:space:]]*=[[:space:]]*i2c-sensor,addr=0x38,chip=aht20[[:space:]]*$|#& # replaced by satellite1-rpi-setup|' "$CFG"
    ensure_overlay_line "i2c-sensor,aht20"
}

# SPI0's default second chip select is BCM 7, which is the Satellite1 action
# button input. Use BCM 26 instead while retaining CS0 on BCM 8 for XMOS.
ensure_spi0_cs1_pin() {
    sed -i -E 's|^[[:space:]]*dtparam[[:space:]]*=[[:space:]]*spi=on[[:space:]]*$|#dtparam=spi=on # managed by satellite1-rpi-setup|' "$CFG"
    if ! grep -Eq '^[[:space:]]*dtoverlay[[:space:]]*=[[:space:]]*spi0-2cs,cs1_pin=26[[:space:]]*$' "$CFG"; then
        sed -i -E 's@^[[:space:]]*dtoverlay[[:space:]]*=[[:space:]]*spi0-(1cs|2cs)(,[^[:space:]]*)?[[:space:]]*$@#\0@' "$CFG"
        ensure_overlay_line "spi0-2cs,cs1_pin=26"
    fi
}

# Ensure a bare "key=value" firmware setting exists; if present (even
# commented), replace it with key=value.
ensure_setting() {
    key="$1"; val="$2"
    if grep -Eq "^[#[:space:]]*${key}[[:space:]]*=" "$CFG"; then
        sed -i -E "s|^[#[:space:]]*${key}[[:space:]]*=.*$|${key}=${val}|" "$CFG"
    else
        printf "%s=%s\n" "$key" "$val" >> "$CFG"
    fi
}

# The LD2410 mmWave presence sensor needs a UART on GPIO 14/15. enable_uart=1
# provides the mini-UART (/dev/ttyS0), which leaves onboard Bluetooth on the
# PL011 and is sufficient for the LD2410 firmware shipped on the Satellite1 HAT
# (115200 baud). Sensors running the Hi-Link factory default of 256000 baud
# want the PL011 instead -- see README "mmWave Sensor UART".
#
# Raspberry Pi OS also ships console=serial0 on the kernel command line, so
# systemd starts a getty on whichever tty serial0 resolves to, and that getty
# holds the port. An application opening it then reads no data, which is
# indistinguishable from a dead sensor or a wrong baud rate. Strip the serial
# console entries; console=tty1 is left alone.
ensure_sensor_uart() {
    ensure_setting enable_uart 1

    [ -f "$CMDLINE" ] || return 0
    if [ ! -f "${CMDLINE}.satellite1.bak" ]; then
        cp -p "$CMDLINE" "${CMDLINE}.satellite1.bak"
        echo "${PACKAGE_NAME}: Backed up cmdline.txt to ${CMDLINE}.satellite1.bak"
    fi
    sed -i -E 's/(^| )console=(serial0|ttyAMA0|ttyS0),[0-9]+//g' "$CMDLINE"
    sed -i -E 's/  +/ /g; s/^ //; s/ $//' "$CMDLINE"
}

case "$1" in
    configure)
        # Sanity check: config.txt must exist
        if [ ! -f "$CFG" ]; then
            echo "${PACKAGE_NAME}: config.txt not found at $CFG" >&2
            exit 0
        fi

        # --- Backup config.txt once ---
        if [ ! -f "${CFG}.satellite1.bak" ]; then
            cp "${CFG}" "${CFG}.satellite1.bak"
            echo "${PACKAGE_NAME}: Backed up config.txt to ${CFG}.satellite1.bak"
        fi

        if [ -d "${SHARE_OVL}" ]; then
            cp -p "${SHARE_OVL}/"*.dtbo "${BOOT_OVL}/" 2>/dev/null || true
            echo "${PACKAGE_NAME}: Copied custom overlays from ${SHARE_OVL} to ${BOOT_OVL}"
        else
            echo "${PACKAGE_NAME}: WARNING: ${SHARE_OVL} not found; no custom overlays copied." >&2
        fi

        # ----- Enable required firmware interfaces & overlays -----
        # Core interfaces
        ensure_spi0_cs1_pin
        ensure_dtparam i2s on
        ensure_dtparam i2c_arm on
        ensure_dtparam_if_missing i2c_arm_baudrate 100000

        # Your overlays
        ensure_overlay_name "satellite1-i2s"
        ensure_overlay_name "fusb302b"

        # Optional sensor overlay
        ensure_aht20_overlay

        # LD2410 mmWave presence sensor (UART)
        ensure_sensor_uart

        # Auto load i2c-dev module
        echo i2c-dev | sudo tee /etc/modules-load.d/i2c.conf

        # Avoid card conflicts with legacy analog audio
        sed -i -E 's/^[[:space:]]*dtparam=audio=on[[:space:]]*$/#dtparam=audio=on/' "$CFG" || true

        echo "${PACKAGE_NAME}: overlays configured. Reboot to apply."
        ;;
esac

exit 0
